platform :ios, '13.0'
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Disable CocoaPods sandbox input/output path tracking.
# Without this, Xcode's "Check Pods Manifest.lock" script phase fails when
# the CI pod install runs fast via cache and Manifest.lock lags behind.
install! 'cocoapods', :disable_input_output_paths => true

project 'Runner', {
  'Debug'   => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated = File.expand_path(File.join('Flutter', 'Generated.xcconfig'), __dir__)
  unless File.exist?(generated)
    raise "#{generated} must exist. Run flutter pub get first."
  end
  File.foreach(generated) do |line|
    m = line.match(/FLUTTER_ROOT\=(.*)/)
    return m[1].strip if m
  end
  raise "FLUTTER_ROOT not found in #{generated}."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# NSE needs Firebase/Messaging for rich-media push images.
target 'NotificationService' do
  use_frameworks!
  pod 'Firebase/Messaging'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
    end
  end

  # Fix: Codemagic caches Pods/ between builds. When Podfile changes
  # (e.g. new NSE target), pod install may reuse the cache without fully
  # updating Manifest.lock. Xcode then fails with "sandbox not in sync".
  # Force-copying Podfile.lock → Manifest.lock guarantees they match.
  require 'fileutils'
  podfile_lock = File.join(File.dirname(File.realpath(__FILE__)), 'Podfile.lock')
  manifest_lock = File.join(installer.sandbox.root.to_s, 'Manifest.lock')
  FileUtils.cp(podfile_lock, manifest_lock) if File.exist?(podfile_lock)
end
